# Ex1 — các định nghĩa phải có trong FreeRTOSConfig.h
#
# Điền giá trị vào chỗ <?>. Đây là file bạn nộp; copy sang FreeRTOSConfig.h thật.
# Mỗi dòng phải giải thích được trong buổi vấn đáp.

configCPU_CLOCK_HZ                      <?>
configTICK_RATE_HZ                      1000
configMAX_PRIORITIES                    <?>
configMINIMAL_STACK_SIZE                <?>
configTOTAL_HEAP_SIZE                   <?>
configUSE_PREEMPTION                    1
configUSE_PORT_OPTIMISED_TASK_SELECTION 0
configCHECK_FOR_STACK_OVERFLOW          <?>
configUSE_MALLOC_FAILED_HOOK            <?>

configPRIO_BITS                         <?>
configLIBRARY_LOWEST_INTERRUPT_PRIORITY         <?>
configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY    <?>

# Ba handler kernel chiếm — map tên port sang tên trong vector table:
# vPortSVCHandler        -> <?>
# xPortPendSVHandler     -> <?>
# xPortSysTickHandler    -> <?>
